{
  "sourceLanguage": "en",
  "strings": {
    "Bearer … (added if you paste just the token)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearer … (sadece token'ı yapıştırırsan eklenir)"
          }
        }
      }
    },
    "New Terminal…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Terminal…"
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler"
          }
        }
      }
    },
    "Queue for Claude": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude için kuyruğa al"
          }
        }
      }
    },
    "Send it on to Claude, or queue it for Claude's next turn": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude'a gönder ya da Claude'un sıradaki turu için kuyruğa al"
          }
        }
      }
    },
    "All resumed sessions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri gelen tüm oturumlar"
          }
        }
      }
    },
    "Every session that comes back at launch gets this message, also one that was waiting on you (your turn, a question, a permission).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılışta geri gelen her oturum bu mesajı alır; sırası sende olanlar (your turn, soru, izin) da."
          }
        }
      }
    },
    "Interrupted sessions only": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece yarıda kalan oturumlar"
          }
        }
      }
    },
    "Only sessions that were working when ClaudeDeck quit (or crashed) get this message. Sessions waiting on you (your turn, a question, a permission) are left as they were.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesajı sadece ClaudeDeck kapanırken (ya da çökerken) çalışmakta olan oturumlar alır. Sırası sende olan oturumlar (your turn, soru, izin) olduğu gibi bırakılır."
          }
        }
      }
    },
    "Send it to": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kime gönderilsin"
          }
        }
      }
    },
    "This agent isn't waiting for approval any more.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ajan artık onay beklemiyor."
          }
        }
      }
    },
    "Paste the webhook URL.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook URL'sini yapıştır."
          }
        }
      }
    },
    "The webhook address isn't a valid URL.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook adresi geçerli bir URL değil."
          }
        }
      }
    },
    "Paste the Authorization header.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization header'ını yapıştır."
          }
        }
      }
    },
    "The header has to be one line of plain characters (no line breaks).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Header tek satır ve düz karakterlerden oluşmalı (satır sonu olmadan)."
          }
        }
      }
    },
    "Paste its webhook URL and header to approve.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamak için webhook URL'sini ve header'ını yapıştır."
          }
        }
      }
    },
    "Fill In and Approve…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doldur ve onayla…"
          }
        }
      }
    },
    "No webhook URL yet": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz webhook URL'si yok"
          }
        }
