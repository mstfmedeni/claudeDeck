    "Last deploy failed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son dağıtım başarısız oldu"
          }
        }
      }
    },
    "Clears it from the sidebar and the phone; ServerPlan keeps the deploy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar çubuğundan ve telefondan kaldırır; ServerPlan dağıtımı tutar"
          }
        }
      }
    },
    "Swipe to clear one. Clearing only hides it here and on the Mac; ServerPlan keeps the deploy.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini temizlemek için kaydır. Temizlemek yalnızca burada ve Mac'te gizler; ServerPlan dağıtımı tutar."
          }
        }
      }
    },
    "Namecheap balance low": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap bakiyesi düşük"
          }
        }
      }
    },
    "Namecheap balance is low: %@ %@ (threshold %@ %@). Top up for domain purchases: Namecheap › Billing › Add Funds.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap bakiyesi düşük: %1$@ %2$@ (eşik %3$@ %4$@). Alan adı alımları için bakiye yükle: Namecheap › Billing › Add Funds."
          }
        }
      }
    },
    "Namecheap balance": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap bakiyesi"
          }
        }
      }
    },
    "Ask Namecheap for the balance now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiyeyi şimdi Namecheap'ten al"
          }
