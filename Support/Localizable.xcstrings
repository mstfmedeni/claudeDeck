    "It registered without its webhook address: paste the URL and header from the routine's panel.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook adresi olmadan kaydoldu: URL'yi ve header'ı routine panelinden yapıştır."
