      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan süreç durdurulur. Claude konuşma geçmişi silinmez; projenin \"Eski Oturumu Devam Ettir…\" menüsünden yeniden açılabilir."
