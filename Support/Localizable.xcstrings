          }
        }
      }
    },
    "Your answer goes to the session as its next message.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtın oturuma bir sonraki mesajı olarak gider."
          }
        }
      }
    },
    "docs/AGENDA.md · changed %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "docs/AGENDA.md · %@ değişti"
          }
        }
      }
    },
    "%@ · %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
