            "value": "Ad (ör. İş, İkinci Max)"
          }
        }
      }
    },
    "Use letters or digits in the name.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adda harf ya da rakam kullan."
          }
        }
