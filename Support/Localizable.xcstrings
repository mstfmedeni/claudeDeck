    "All apps, data and settings on this simulator are deleted. This can’t be undone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu simülatördeki tüm uygulamalar, veriler ve ayarlar silinir. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "The simulator is shut down first. All apps, data and settings on it are deleted. This can’t be undone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simülatör önce kapatılır. Üzerindeki tüm uygulamalar, veriler ve ayarlar silinir. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "simslim turns off background services the simulator doesn’t need and reboots it. Push notifications, widgets and WatchConnectivity stay on.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "simslim, simülatörün ihtiyaç duymadığı arka plan servislerini kapatır ve onu yeniden başlatır. Anlık bildirimler, widget'lar ve WatchConnectivity açık kalır."
          }
        }
      }
    },
    "simslim turns every service back on and reboots the simulator.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "simslim tüm servisleri yeniden açar ve simülatörü yeniden başlatır."
          }
        }
      }
    },
    "Simulators are turned off": {
