    "In-App Tailscale": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama İçi Tailscale"
          }
        }
      }
    },
    "Reaches your Mac's Tailscale address from this app, without the Tailscale app's VPN, alongside any VPN. When the system can reach the Mac (the Tailscale app is on), that comes first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inin Tailscale adresine Tailscale uygulamasının VPN'i olmadan, doğrudan bu uygulamadan ulaşır; başka bir VPN açıkken de çalışır. Sistem Mac'e ulaşabiliyorsa (Tailscale uygulaması açıksa) önce o denenir."
          }
        }
      }
    },
    "Tailscale Address": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale Adresi"
          }
        }
      }
    },
