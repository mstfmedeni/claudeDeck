          }
        }
      }
    },
    "Any Account (Not Pinned)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi Bir Hesap (Sabitlenmemiş)"
          }
        }
      }
    },
    "New Claude Session on Account": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesapta Yeni Claude Oturumu"
          }
        }
      }
    },
    "not logged in": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "oturum açılmamış"
          }
        }
      }
    },
    "limit reached": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "limit doldu"
          }
        }
      }
    },
    "The session wasn't moved": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum taşınmadı"
          }
        }
      }
    },
    "Nobody is logged in on that account yet: Settings › Accounts › Log In…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O hesapta henüz kimse giriş yapmadı: Ayarlar › Hesaplar › Giriş Yap…"
          }
        }
      }
    },
    "ClaudeDeck doesn't know this session's conversation yet, so it can't be resumed on another account.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ClaudeDeck bu oturumun konuşmasını henüz bilmiyor, bu yüzden başka bir hesapta sürdürülemez."
          }
        }
      }
    },
    "It is already being moved.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten taşınıyor."
          }
        }
      }
    },
    "Its Claude process didn't end, so it wasn't resumed elsewhere.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude süreci kapanmadı, bu yüzden başka yerde sürdürülmedi."
          }
        }
      }
    },
    "Default account": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan hesap"
          }
        }
      }
    },
    "Add a project first": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir proje ekle"
          }
        }
      }
    },
    "The login runs in a terminal, and terminals belong to a project.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş bir terminalde yapılır, terminaller de bir projeye aittir."
          }
        }
      }
    },
    "Login · %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş · %@"
          }
        }
      }
    },
    "%@ is in use": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kullanımda"
          }
        }
      }
    },
    "Move or stop its sessions first: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce oturumlarını taşı ya da durdur: %@"
          }
        }
      }
    },
    "Remove the account %@?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hesabı kaldırılsın mı?"
          }
        }
      }
    },
    "Its sessions move to the default account. Its folder goes to the Trash; conversations stay (they're shared). The login stays in the Keychain: run `claude auth logout` in its login terminal first to remove it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
