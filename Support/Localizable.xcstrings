    "Namecheap balance alert (USD)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namecheap bakiye uyarısı (USD)"
          }
        }
      }
    },
    "ServerPlan's own threshold (%@ %@) is used; this one applies when ServerPlan has none.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ServerPlan'ın kendi eşiği (%1$@ %2$@) kullanılıyor; bu ayar yalnızca ServerPlan'da eşik yoksa geçerli."
          }
        }
      }
    },
    "A notification on the Mac and the phone when the balance goes under this (once, until it's topped up). 0 turns it off.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiye bunun altına düşünce Mac'te ve telefonda bildirim (bakiye yüklenene kadar bir kez). 0 kapatır."
          }
        }
      }
    },
    "Account balance %@ %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bakiyesi %1$@ %2$@"
