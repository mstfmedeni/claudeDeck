          }
        }
      }
    },
    "Keep on This Account": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Hesapta Tut"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
