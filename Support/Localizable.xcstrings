    "Licenses": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisanslar"
          }
        }
      }
    },
    "ClaudeDeck for iPhone and iPad is free software under the GNU GPL v3 (it includes open-screen-sharing). Source: github.com/mstfmedeni/claudeDeck": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ve iPad için ClaudeDeck, GNU GPL v3 lisanslı özgür yazılımdır (open-screen-sharing'i içerir). Kaynak kodu: github.com/mstfmedeni/claudeDeck"
          }
        }
      }
    },
    "GNU General Public License v3": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Genel Kamu Lisansı v3"
          }
        }
      }
    },
    "Mac Screen (open-screen-sharing and its components)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Ekranı (open-screen-sharing ve bileşenleri)"
          }
        }
