+package main
+
+import "os"
+
+// ClaudeDeck: the node never uploads its diagnostic logs to log.tailscale.com
+// (envknob.NoLogsNoSupport, read when the log transport is made). Go copies
+// the environment when it starts, so a setenv from Swift would come too late;
+// this runs in the library's own init instead.
+func init() {
+	os.Setenv("TS_NO_LOGS_NO_SUPPORT", "true")
+}
